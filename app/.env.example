# Copy this file to .env.local, then fill in the two values.
#
# Find both in the Supabase dashboard: open your project, click Connect at the
# top, and it shows the URL and the publishable key together, ready to paste.
# The full list also lives under Settings -> API Keys.
#
# The PUBLISHABLE key is the one you want. It looks like sb_publishable_...
# and is meant to be public — it ships inside the browser bundle, and row-level
# security is what actually protects your data.
#
# NEVER put a SECRET key here (sb_secret_... or the old service_role). It
# bypasses row-level security entirely, and anything in a VITE_ variable is
# visible to everyone who opens the site.
#
# Older projects have an "anon" key instead: a long string starting eyJ.
# That still works — put it in VITE_SUPABASE_PUBLISHABLE_KEY — but Supabase is
# retiring anon keys at the end of 2026, so prefer the publishable one.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
