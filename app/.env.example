# Copy this file to .env.local and fill in the two values from Supabase:
#   Project Settings -> Data API (or API) -> Project URL and anon public key
#
# The anon key is meant to be public — it ships inside the browser bundle, and
# row-level security is what actually protects your data. Even so, .env.local
# is gitignored: keep your project's identifiers out of the repository.
#
# NEVER put the service_role key in here. It bypasses row-level security
# entirely, and anything in a VITE_ variable is visible to everyone who opens
# the site.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
